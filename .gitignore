# === SwingScan data + weights ===
# All downloaded datasets, processed artifacts, and model checkpoints are
# user-local and must never be committed. See data/README.md and
# models/README.md.
#
# Pattern note: we can't write `data/` and then `!data/README.md` because
# once the directory is ignored git stops descending into it. The correct
# form is to ignore files inside via `data/**` and then allow-list
# individual tracked files.
data/**
!data/README.md
!data/.gitkeep
!data/**/.gitkeep
models/**
!models/README.md
!models/.gitkeep

# === Media ===
# Default-deny on raw video outside the small test fixtures dir.
*.mp4
*.mov
*.avi
*.mkv
*.webm
!tests/fixtures/*.mp4
!tests/fixtures/*.mov

# === Secrets ===
.env
.env.local
*.pem
*.key
credentials.json

# === Notebook checkpoints ===
.ipynb_checkpoints/

# === Misc temp ===
*.log
*.tmp
tmp/
